{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@storagehub/presentation/*": ["./src/presentation/*"],
      "@/*": [
        "./src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@storagehub/presentation",
    "types": [
      "node"
    ],
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
